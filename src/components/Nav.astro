---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-name">Romil Shah</a>
    <nav class="header-nav" aria-label="Site navigation">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#education">Education</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#contact">Contact</a>
      <a
        href="https://github.com/Romil2112"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-github"
      >GitHub ↗</a>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.875rem;
  }

  .site-name {
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
    margin-right: auto;
    flex-shrink: 0;
  }

  .site-name:hover {
    color: var(--accent);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header-nav a {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-nav a:hover {
    color: var(--text);
  }

  .nav-github {
    color: var(--accent) !important;
  }

  .nav-github:hover {
    color: var(--accent-hover) !important;
  }

  /* On mobile, hide section links — the page is short enough to scroll naturally */
  @media (max-width: 767px) {
    .header-nav {
      display: none;
    }
  }
</style>
